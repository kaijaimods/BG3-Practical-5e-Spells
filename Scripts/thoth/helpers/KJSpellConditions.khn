local __util = require 'larian.util'

function KJSkipOffhandModifier()
	return (HasPassive('FightingStyle_TwoWeaponFighting',context.Source))
end

function KJAddPactModifier()
	return (~KJSkipOffhandModifier() & (HasStatus('HEXBLADE_BIND', GetActiveWeapon(context.Source, false)) | HasStatus('PACT_BLADE', GetActiveWeapon(context.Source, false))))
end

function KJAddCastModifier()
	return (~KJSkipOffhandModifier() & ~KJAddPactModifier() & (HasStatus('SHILLELAGH', GetActiveWeapon(context.Source, false)) | HasPassive('MAG_MeleeCaster_Passive',context.Source)))
end

function KJAddFinesseModifier()
	return (~KJSkipOffhandModifier() & ~KJAddPactModifier() & ~KJAddCastModifier() & WieldingWeapon('Finesse', true, true, context.Source))
end

function KJAddStrengthModifier()
	return (~KJSkipOffhandModifier() & ~KJAddPactModifier() & ~KJAddCastModifier() & ~KJAddFinesseModifier())
end



function KJCanCatapult(value)
	return ConditionResult(value >= (context.Target.Weight / 1000),{ConditionError("KJCatapultHeavy_False")}) and ConditionResult(0.5 <= (context.Target.Weight / 1000),{ConditionError("KJCatapultLight_False")})
end

function KJDoCAcid()
	return HasStatus('KJ_CHAOSDAMAGE_ACID', context.Source)
end
function KJDoCCold()
	return HasStatus('KJ_CHAOSDAMAGE_COLD', context.Source)
end
function KJDoCFire()
	return HasStatus('KJ_CHAOSDAMAGE_FIRE', context.Source)
end
function KJDoCForce()
	return HasStatus('KJ_CHAOSDAMAGE_FORCE', context.Source)
end
function KJDoCLightning()
	return HasStatus('KJ_CHAOSDAMAGE_LIGHTNING', context.Source)
end
function KJDoCPoison()
	return HasStatus('KJ_CHAOSDAMAGE_POISON', context.Source)
end
function KJDoCPsychic()
	return HasStatus('KJ_CHAOSDAMAGE_PSYCHIC', context.Source)
end
function KJDoCThunder()
	return HasStatus('KJ_CHAOSDAMAGE_THUNDER', context.Source)
end
function KJDoCNone()
	return  ~(KJDoCAcid() | KJDoCCold() | KJDoCFire() | KJDoCForce() | KJDoCLightning() | KJDoCPoison() | KJDoCPsychic() | KJDoCThunder())
end

function KJGuardianOfNatureBeast()
	return ConditionResult(context.HitDescription.AttackAbility == Ability.Strength)
end

function KJGuardianOfNatureTree()
	return ConditionResult(context.HitDescription.AttackAbility == Ability.Dexterity) | ConditionResult(context.HitDescription.AttackAbility == Ability.Wisdom)
end

function KJHasDragonsBreath()
	return ConditionResult(HasStatus('KJ_DRAGONSBREATH_DC',context.Target).Result,{ConditionError("CE_Status_SG_DragonsBreath_True")},{ConditionError("CE_Status_SG_DragonsBreath_True")})
end

function KJIsCloudSurface()
	return Surface('WaterCloud') | Surface('WaterCloudElectrified') | Surface('PoisonCloud') | Surface('ExplosionCloud') | Surface('ShockwaveCloud') | Surface('CloudkillCloud') | Surface('MaliceCloud') | Surface('BloodCloud') | Surface('StinkingCloud') | Surface('DarknessCloud') | Surface('FogCloud') | Surface('GithPheromoneGasCloud') | Surface('SporeWhiteCloud') | Surface('SporeGreenCloud') | Surface('SpreBlackCloud') | Surface('DrowPoisonCloud') | Surface('IceCloud') | Surface('SporePinkCloud') | Surface('BlackPowderDetonationCloud') | Surface('VoidCloud') | Surface('CrawlerMucusCloud') | Surface('Cloudkill6Cloud')
end

function IsMentalSaveInteresting(value)
    local value = value or 20
    local rollInteresting = IsRerollInteresting(value)
	
    local result = rollInteresting
	
    return ConditionResult(result)
end

function IsRerollInteresting(value)
    local value = value or 20
    local rollSuccess = false
	
    if context.InterruptedRoll.RollCritical == RollCritical.None then
        rollSuccess = context.InterruptedRoll.Total >= context.InterruptedRoll.Difficulty
    else
        rollSuccess = context.InterruptedRoll.RollCritical == RollCritical.Success
    end
	
    return ConditionResult(not rollSuccess)
end

function KJGetSummonerModifier()
	entity = GetSummoner(context.Source)
	result = GetModifier(entity.Wisdom)
	if entity.Charisma > entity.Wisdom then
		result = GetModifier(entity.Charisma)
	end
	return result
end